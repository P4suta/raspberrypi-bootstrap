[Unit]
Description=Private Beszel metrics hub
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/monitoring/hub.env

[Container]
# renovate: version=0.21.2
Image=docker.io/henrygd/beszel@sha256:b0be90bd4aee2993fde763032a5098ce4386fba43cfe5031ec017b8d9e8c97a2
ContainerName=monitoring-beszel
Network=monitoring.network
PublishPort=127.0.0.1:8090:8090
Volume=beszel.volume:/beszel_data:U
EnvironmentFile=%h/.config/monitoring/hub.env
User=10001:10001
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
Tmpfs=/tmp:rw,nodev,nosuid,noexec,size=32m,mode=1777

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=default.target
