[Unit]
Description=Private Beszel host metrics agent
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/apps/.config/monitoring/pi-agent.env

[Service]
Environment=DATA_DIR=/var/lib/beszel-agent
EnvironmentFile=/var/lib/apps/.config/monitoring/pi-agent.env
ExecStart=/var/lib/apps/monitoring/bin/beszel-agent
Restart=on-failure
RestartSec=5
PrivateUsers=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/beszel-agent
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=default.target
